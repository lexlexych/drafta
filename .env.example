NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key


# Channel account-connect (OAuth) flow — user connects a channel via the
# provider's hosted authorization page, never the Zernio dashboard
# (docs/architecture/05-channels.md#подключение-аккаунта-oauth).
# ZERNIO_API_KEY is the Bearer token for the Zernio REST API (profiles + connect).
ZERNIO_API_KEY=your-zernio-api-key
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=your-zernio-webhook-secret

# Signs the OAuth `state` for the channel account-connect flow
# (lib/channels/connect-state.ts). Any long random string.
CHANNEL_CONNECT_STATE_SECRET=your-channel-connect-state-secret


# Подписывает вызовы крон-роутов (`app/api/cron/*`). Vercel Cron шлёт его как
# `Authorization: Bearer $CRON_SECRET`; без него роуты сводки и чистки логов
# были бы открыты всему интернету (docs/architecture/18-workflows.md).
# Локально не нужен: без переменной крон-роуты открыты только вне production.
CRON_SECRET=your-cron-secret


MISTRAL_API_KEY=your-mistral-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=vendor/model

# Web Push (docs/architecture/11-realtime-pwa.md#web-push)
# Сгенерировать пару: `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY — тот же публичный ключ, но доступный браузеру
# для `pushManager.subscribe`. VAPID_PRIVATE_KEY — только сервер (rule 5).
VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Контакт для VAPID (mailto: или https URL). По умолчанию mailto:support@drafta.app.
VAPID_SUBJECT=mailto:support@drafta.app

# Encrypts stored channel credentials/tokens for future providers (Meta direct
# integration — docs/architecture/06-data-model.md#channel_connections).
CREDENTIALS_ENCRYPTION_KEY=your-credentials-encryption-key
