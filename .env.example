NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Zernio (lib/channels/zernio) — unified inbox API, DM channels: Telegram, WhatsApp,
# Instagram, Facebook. See docs/architecture/13-environments-secrets.md and
# docs/epics/epic_02/T-07-executive-summary.md (dashboard setup steps).
# API access for outgoing sends (lib/channels/zernio's sendMessage — implemented
# starting stage 3 of the rollout plan; unused by this adapter for now).
ZERNIO_API_KEY=your-zernio-api-key
# Shared secret used to verify the HMAC-SHA256 `X-Zernio-Signature` webhook header —
# see lib/channels/zernio/verify.ts. Never commit a real value.
ZERNIO_WEBHOOK_SECRET=your-zernio-webhook-secret

# Inngest (lib/inngest) — see docs/architecture/13-environments-secrets.md.
# The webhook route (app/api/webhooks/[provider]/route.ts) emits
# "interaction/received" fail-safe via lib/inngest/events.ts; the SDK reads
# these from the environment itself (lib/inngest/client.ts), so both are
# optional for local dev against `npx inngest-cli dev` but required in
# Production. serve() and Inngest functions land starting stage 2 of the
# rollout plan (docs/architecture/16-rollout-plan.md).
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# lib/ai — LLM client (docs/architecture/08-ai-subsystem.md), used by the
# generate-draft Inngest function starting stage 2. Fill in exactly one
# provider: MISTRAL_API_KEY (primary), or OPENROUTER_API_KEY +
# OPENROUTER_MODEL (fallback, used only when MISTRAL_API_KEY is unset).
# Not read by any code yet (stage 1 / E-002 scope).
MISTRAL_API_KEY=your-mistral-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
# vendor/model format, e.g. "mistralai/mistral-large"
OPENROUTER_MODEL=vendor/model

# Web Push (docs/architecture/11-realtime-pwa.md#web-push) — stage 9, not
# read by any code yet.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Encrypts stored channel credentials/tokens for future providers (Meta direct
# integration — docs/architecture/06-data-model.md#channel_connections).
# Stage 11+, not read by any code yet.
CREDENTIALS_ENCRYPTION_KEY=your-credentials-encryption-key
